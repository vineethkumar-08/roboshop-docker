FROM python:3.9.25-alpine3.22 AS builderWORKDIR /app
COPY package.json .
COPY *.js .
RUN npm install



FROM python:3.9.25-alpine3.22WORKDIR /app
EXPOSE 8080
COPY --from=builder /app /app
#this env is going to be handeled in k8s configmap
RUN addgroup -S roboshop && adduser -S roboshop -G roboshop
RUN chown -R roboshop:roboshop /app
USER roboshop
CMD ["server.js"]
ENTRYPOINT ["node"]


